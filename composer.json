{
    "name": "paulkakell/twitchybutt",
    "type": "project",
    "description": "Self-hosted creator CMS: development foundation, not production checkout.",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-ctype": "*",
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {"psr-4": {"App\\": "app/"}},
    "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
    "scripts": {
        "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
        "test": "phpunit",
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": ["@lint", "@analyse", "@test"]
    },
    "config": {"sort-packages": true, "preferred-install": "dist", "optimize-autoloader": true, "allow-plugins": {}},
    "minimum-stability": "stable",
    "prefer-stable": true
}
