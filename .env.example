APP_NAME="TwitchyButt CMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
DB_CONNECTION=sqlite
# Set an absolute path when moving the database outside database/database.sqlite.
# DB_DATABASE=/absolute/path/to/database.sqlite
# PostgreSQL example: DB_CONNECTION=pgsql; DB_HOST=127.0.0.1; DB_PORT=5432
# DB_DATABASE=twitchybutt; DB_USERNAME=twitchybutt; DB_PASSWORD=<local secret>
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
LOG_CHANNEL=daily
LOG_LEVEL=info
CMS_PAYMENTS_ENABLED=false
CMS_RESTRICTED_PUBLISHING_ENABLED=false
# Opt in only after configuring the creator-owned SMTP service and queue worker.
CMS_ACCOUNT_MAIL_ENABLED=false
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=localhost
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.test
MAIL_FROM_NAME="Creator site"

# Bounded server-side session deadlines.
CMS_SESSION_IDLE_MINUTES=30
CMS_SESSION_ABSOLUTE_MINUTES=720
